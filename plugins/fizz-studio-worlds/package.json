	},
	"devDependencies": {
		"@rollup/plugin-typescript": "^12.1.4",
		"rollup": "^4.59.1",
		"tslib": "^2.8.1",
		"typescript": "~5.8.3",
		"vitest": "^4.1.9"
	}
}
