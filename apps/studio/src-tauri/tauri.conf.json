{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Fizz Level Studio",
	"version": "0.1.0",
	"identifier": "ca.liminalhq.fizzstudio",
	"build": {
		"beforeDevCommand": "bun run dev",
		"beforeBuildCommand": "bun run build",
		"devUrl": "http://localhost:1430",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"publisher": "Liminal HQ",
		"homepage": "https://github.com/liminal-hq/fizz-level-studio",
		"copyright": "Copyright 2026 Liminal HQ, Scott Morris",
		"license": "Apache-2.0 OR MIT",
		"category": "DeveloperTool",
		"shortDescription": "The level and overworld editor for Lieutenant Fizz",
		"longDescription": "Fizz Level Studio is where a person and Claude design Lieutenant Fizz levels and overworlds together."
	}
}
