{
	"name": "@liminal-hq/fizz-level-studio",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"tauri": "tauri",
		"tauri:dev": "tauri dev --config src-tauri/tauri.conf.dev.json",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"predev": "bun run --cwd ../.. build:plugins",
		"prebuild": "bun run --cwd ../.. build:plugins",
		"pretypecheck": "bun run --cwd ../.. build:plugins",
		"pretest": "bun run --cwd ../.. build:plugins",
		"pretest:ci": "bun run --cwd ../.. build:plugins",
		"test:ci": "mkdir -p ../../test-results && vitest run --reporter=default --reporter=junit --outputFile.junit=../../test-results/frontend-junit.xml"
	},
	"dependencies": {
		"@codemirror/autocomplete": "6.20.4",
		"@codemirror/commands": "6.11.1",
		"@codemirror/language": "6.13.1",
		"@codemirror/lint": "6.9.7",
		"@codemirror/search": "6.7.2",
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.15",
		"@lezer/highlight": "1.2.5",
		"@liminal-hq/fizz-studio-chrome": "workspace:*",
		"@liminal-hq/fizz-studio-plugin-host": "workspace:*",
		"@liminal-hq/fizz-studio-plugin-settings": "workspace:*",
		"@liminal-hq/fizz-studio-plugin-worlds": "workspace:*",
		"@liminal-hq/fizz-studio-protocol": "workspace:*",
		"@liminal-hq/fizz-studio-ribbon": "workspace:*",
		"@liminal-hq/plugin-window-effects": "workspace:*",
		"@liminal-hq/plugin-window-tearoff": "workspace:*",
		"@liminal-hq/plugin-system-appearance": "^0.1.0",
		"@liminal-hq/plugin-window-manager": "^0.1.0",
		"@tauri-apps/api": "^2.10.1",
		"@tauri-apps/plugin-clipboard-manager": "^2.5.0",
		"@tauri-apps/plugin-dialog": "^2.8.4",
		"@tauri-apps/plugin-log": "^2.8.0",
		"@tauri-apps/plugin-os": "^2.3.2",
		"react": "^19.1.0",
		"react-dom": "^19.1.0"
	},
	"devDependencies": {
		"@tauri-apps/cli": "^2",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@vitejs/plugin-react": "^4.6.0",
		"happy-dom": "^20.8.4",
		"typescript": "~5.8.3",
		"vite": "^7.0.4",
		"vitest": "^4.1.9"
	}
}
